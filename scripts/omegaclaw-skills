#!/usr/bin/env python3
"""OmegaClaw filesystem-skills CLI (Issue #13).

Subcommands (more arrive with the install lifecycle in Issue #12):

  doctor   Report skill readiness — which loaded SKILL.md bundles are eligible here and,
           for the rest, exactly what is missing (env var / binary / config / OS / toolset)
           with actionable remediation. Never prints secret values.

Usage:
  scripts/omegaclaw-skills doctor [--json] [--config PATH]

Stdlib only. Skill roots/policy come from profile/skills.yaml (or OMEGACLAW_SKILLS_CONFIG_PATH).
"""

import argparse
import json
import os
import sys

_REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(_REPO_ROOT, "src"))


def _load_config(path):
    import skill_loader
    if path:
        os.environ["OMEGACLAW_SKILLS_CONFIG_PATH"] = path
        skill_loader.reset_cache()
    return skill_loader.load_config()


def cmd_doctor(args):
    import skill_policy
    report = skill_policy.doctor(_load_config(args.config))
    if args.json:
        print(json.dumps(report, indent=2))
        return 0

    c = report["counts"]
    print("OmegaClaw skills doctor  (OS: {})".format(report["os"]))
    print("  eligible: {}   blocked: {}   invalid: {}".format(c["eligible"], c["blocked"], c["invalid"]))
    if report["eligible"]:
        print("\nELIGIBLE ({}):".format(c["eligible"]))
        for name in report["eligible"]:
            print("  ✓ {}".format(name))
    if report["blocked"]:
        print("\nBLOCKED ({}) — needs setup:".format(c["blocked"]))
        for b in report["blocked"]:
            print("  ✗ {}".format(b["name"]))
            for r in b["reasons"]:
                print("      - [{}] {}".format(r["kind"], r["detail"]))
                print("        fix: {}".format(r["remediation"]))
    if report["errors"]:
        print("\nINVALID ({}) — malformed bundles:".format(c["invalid"]))
        for e in report["errors"]:
            print("  ! {}: {}".format(e["path"], e["message"]))
    # Exit non-zero if nothing is usable but bundles exist, so scripts can gate on it.
    return 0


def _out(args, obj, text):
    if getattr(args, "json", False):
        print(json.dumps(obj, indent=2))
    else:
        print(text)
    return 0 if obj.get("ok", True) else 1


def cmd_install(args):
    import skill_install
    _load_config(args.config)
    r = skill_install.install(args.source, pin=args.pin, force=args.force, approve_high=args.approve)
    if r.get("ok"):
        names = ", ".join("{}[{}]".format(i["name"], i["status"]) for i in r["installed"])
        return _out(args, r, "installed from {}: {}".format(r["source_type"], names))
    return _out(args, r, "install failed: {}".format(r.get("error")))


def cmd_update(args):
    import skill_install
    _load_config(args.config)
    r = skill_install.update(args.name, all_skills=args.all)
    if "error" in r and not r.get("updated"):
        return _out(args, r, "update failed: {}".format(r.get("error")))
    lines = "; ".join("{} {}".format(u["name"], u["status"]) for u in r.get("updated", []))
    return _out(args, r, "update: {}".format(lines or "(nothing)"))


def cmd_list(args):
    import skill_install
    _load_config(args.config)
    items = skill_install.list_installed()
    obj = {"ok": True, "skills": items}
    lines = ["installed skills ({}):".format(len(items))]
    for it in items:
        lines.append("  {}{} v{} <- {}:{}{}".format(
            it["name"], " (pinned)" if it.get("pinned") else "", it.get("version") or "?",
            it.get("source_type"), it.get("source"),
            "@" + it["ref"] if it.get("ref") else ""))
    return _out(args, obj, "\n".join(lines))


def cmd_remove(args):
    import skill_install
    _load_config(args.config)
    r = skill_install.remove(args.name)
    return _out(args, r, "removed {}".format(args.name) if r.get("ok") else r.get("error"))


def cmd_verify(args):
    import skill_install
    _load_config(args.config)
    r = skill_install.verify(args.name)
    lines = ["verify ({}):".format("ok" if r["ok"] else "PROBLEMS")]
    for s in r["skills"]:
        lines.append("  {} {}".format(s["status"].upper().ljust(9), s["name"]))
    return _out(args, r, "\n".join(lines))


def cmd_pin(args):
    import skill_install
    _load_config(args.config)
    r = (skill_install.unpin if args.unpin else skill_install.pin)(args.name)
    return _out(args, r, "{} {}".format("unpinned" if args.unpin else "pinned", args.name)
                if r.get("ok") else r.get("error"))


def cmd_scan(args):
    """Static trust scan of a local bundle dir (or a dir of bundles) before installing it."""
    import skill_loader
    import install_policy
    path = os.path.abspath(args.path)
    # Fail loud for automation: a nonexistent path, invalid bundles, or zero discovered
    # bundles must NOT report CLEAN success (PR #38 review). --allow-empty opts out.
    if not os.path.exists(path):
        return _out(args, {"ok": False, "error": "path does not exist: {}".format(args.path)},
                    "scan error: path does not exist: {}".format(args.path))
    skills, load_errors = skill_loader.load_skills(
        {"version": 1, "roots": [path], "include_plugin_skill_roots": False})
    if load_errors:
        obj = {"ok": False, "error": "invalid bundle(s)",
               "load_errors": [str(e) for e in load_errors]}
        return _out(args, obj, "scan error — invalid bundle(s):\n" +
                    "\n".join("  - " + str(e) for e in load_errors))
    if not skills and not args.allow_empty:
        return _out(args, {"ok": False, "error": "no skill bundles found under {}".format(args.path)},
                    "scan error: no skill bundles found under {} (use --allow-empty to allow)".format(args.path))
    results = []
    worst = "clean"
    for name in sorted(skills):
        sk = skills[name]
        report = install_policy.scan_bundle(sk.base_dir, declared_env=sk.required_environment_variables)
        decision = install_policy.decide(report)
        if decision.action != "allow":
            worst = "blocked"
        elif decision.trust == "flagged" and worst == "clean":
            worst = "flagged"
        results.append({"name": name, "decision": decision.action, "trust": decision.trust,
                        "report": report.as_dict()})
    obj = {"ok": worst != "blocked", "worst": worst, "skills": results}
    lines = ["scan ({} bundle(s)) — {}:".format(len(results), worst.upper())]
    for r in results:
        lines.append("  {} [{}] trust={}".format(r["name"], r["decision"].upper(), r["trust"]))
        for f in r["report"]["findings"]:
            lines.append("      - [{}] {} ({}): {}".format(
                f["severity"].upper(), f["kind"], f["path"], f["detail"]))
    return _out(args, obj, "\n".join(lines))


def cmd_workshop(args):
    """Governed skill workshop (Issue #14): review agent-proposed skills before they go live."""
    import skill_workshop as sw
    _load_config(args.config)
    action = args.workshop_action
    if action == "list":
        items = sw.list_proposals()
        lines = ["proposals ({}):".format(len(items))]
        for it in items:
            lines.append("  {} [{}] {} name={} — {}".format(
                it["id"], it["status"].upper(), it["kind"], it.get("name"),
                "; ".join(it.get("reasons") or []) or "ok"))
        return _out(args, {"ok": True, "proposals": items}, "\n".join(lines))
    if action == "inspect":
        r = sw.inspect(args.id)
        if not r.get("ok"):
            return _out(args, r, "error: {}".format(r.get("error")))
        text = "proposal {}\n  meta: {}\n--- SKILL.md ---\n{}".format(
            args.id, json.dumps(r["meta"], indent=2), r["skill_md"])
        return _out(args, r, text)
    if action == "apply":
        r = sw.apply(args.id, approve_high=args.approve)
        return _out(args, r, "applied {} ({})".format(args.id, r.get("name")) if r.get("ok")
                    else "apply failed: {}".format(r.get("error")))
    if action == "reject":
        r = sw.reject(args.id, args.reason or "")
        return _out(args, r, "rejected {}".format(args.id) if r.get("ok") else r.get("error"))
    if action == "quarantine":
        r = sw.quarantine(args.id, args.reason or "manual")
        return _out(args, r, "quarantined {}".format(args.id) if r.get("ok") else r.get("error"))
    if action == "revise":
        body = None
        if args.file:
            with open(args.file, encoding="utf-8") as f:
                body = f.read()
        r = sw.revise(args.id, skill_md=body)
        return _out(args, r, "revised {} -> {}".format(args.id, r.get("status")) if r.get("ok")
                    else r.get("error"))
    if action == "rollback":
        r = sw.rollback(args.id)
        return _out(args, r, "rolled back {}".format(args.id) if r.get("ok") else r.get("error"))
    return _out(args, {"ok": False, "error": "unknown workshop action"}, "unknown workshop action")


def build_parser():
    # --config on the TOP parser carries the default (None). Subcommands accept --config too,
    # but with default=SUPPRESS so that when it's absent the subparser does NOT overwrite the
    # top-level value in the shared namespace — so `--config X install …` (top-level, as the
    # help advertises) and `install --config X …` BOTH target the intended root, and a
    # write/delete command can never silently fall back to the default skill root.
    common_top = argparse.ArgumentParser(add_help=False)
    common_top.add_argument("--config", default=None,
                            help="path to skills config YAML (default profile/skills.yaml)")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--config", default=argparse.SUPPRESS,
                        help="path to skills config YAML (default profile/skills.yaml)")
    jsn = argparse.ArgumentParser(add_help=False)
    jsn.add_argument("--json", action="store_true", help="emit result as JSON")

    p = argparse.ArgumentParser(prog="omegaclaw-skills", parents=[common_top],
                                description="OmegaClaw filesystem-skills CLI")
    sub = p.add_subparsers(dest="command")

    d = sub.add_parser("doctor", parents=[common, jsn], help="report skill eligibility + remediation")
    d.set_defaults(func=cmd_doctor)

    ins = sub.add_parser("install", parents=[common, jsn],
                         help="install a skill from local:/git:/clawhub: source")
    ins.add_argument("source", help="local:<path> | git:owner/repo@ref | clawhub:<slug>@<ver>")
    ins.add_argument("--pin", action="store_true", help="pin after install (protected from update --all)")
    ins.add_argument("--force", action="store_true", help="reinstall even if pinned")
    ins.add_argument("--approve", action="store_true",
                     help="explicitly approve HIGH-severity scan findings (Issue #19); "
                          "without it such bundles are denied (fail-closed)")
    ins.set_defaults(func=cmd_install)

    up = sub.add_parser("update", parents=[common, jsn], help="reinstall from the recorded source")
    up.add_argument("name", nargs="?", help="skill to update (omit with --all)")
    up.add_argument("--all", action="store_true", help="update every non-pinned skill")
    up.set_defaults(func=cmd_update)

    ls = sub.add_parser("list", parents=[common, jsn], help="list installed skills + lock metadata")
    ls.set_defaults(func=cmd_list)

    rm = sub.add_parser("remove", parents=[common, jsn], help="remove an installed skill")
    rm.add_argument("name")
    rm.set_defaults(func=cmd_remove)

    vf = sub.add_parser("verify", parents=[common, jsn], help="check installed skills against their lock hash")
    vf.add_argument("name", nargs="?", help="skill to verify (omit for all)")
    vf.set_defaults(func=cmd_verify)

    pn = sub.add_parser("pin", parents=[common, jsn], help="pin (or --unpin) an installed skill")
    pn.add_argument("name")
    pn.add_argument("--unpin", action="store_true", help="unpin instead of pin")
    pn.set_defaults(func=cmd_pin)

    sc = sub.add_parser("scan", parents=[common, jsn],
                        help="static trust scan of a local bundle before installing (Issue #19)")
    sc.add_argument("path", help="path to a skill bundle dir (or a dir of bundles)")
    sc.add_argument("--allow-empty", action="store_true",
                    help="exit 0 even if no bundles are discovered (default: error)")
    sc.set_defaults(func=cmd_scan)

    # workshop: governed proposal queue (Issue #14). `apply` is the operator-only boundary that
    # actually changes active skills; everything else is queue inspection/management.
    ws = sub.add_parser("workshop", parents=[common, jsn],
                        help="review agent-proposed skills (list/inspect/apply/reject/revise/quarantine/rollback)")
    wsa = ws.add_subparsers(dest="workshop_action")
    wsa.add_parser("list", parents=[common, jsn], help="list proposals + status")
    for act in ("inspect", "apply", "reject", "revise", "quarantine", "rollback"):
        sp = wsa.add_parser(act, parents=[common, jsn])
        sp.add_argument("id", help="proposal id")
        if act == "apply":
            sp.add_argument("--approve", action="store_true",
                            help="explicitly approve HIGH-severity scan findings on apply")
        if act in ("reject", "quarantine"):
            sp.add_argument("--reason", help="audit reason")
        if act == "revise":
            sp.add_argument("--file", help="path to the new SKILL.md content")
    ws.set_defaults(func=cmd_workshop)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
